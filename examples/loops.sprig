# while updates an existing binding.
let count = 0
while count < 3:
    print(count)
    count = count + 1
end

# for, continue, and break.
for value in range(1, 6):
    when value == 2:
        continue
    end
    when value == 4:
        break
    end
    print(value)
end

when count < 3:
    print("small")
elif count == 3:
    print("three")
otherwise:
    print("large")
end
